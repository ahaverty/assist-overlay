<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Keeps the CPU up while Friday is thinking or talking, so a reply doesn't stall when the screen goes off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Phone actions (PhoneActions.kt): alarms and timers through the Clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Directions to a contact's address (looked up on the phone, never sent anywhere). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- The edge tab the panel tucks into (EdgeTab.kt). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Pulling down from the top of the overlay opens the notification shade (AssistSession). -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <queries>
        <package android:name="com.anthropic.claude" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- "Open Spotify": any launcher app, found by its name (PhoneActions.kt). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:name=".App"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security"
        android:supportsRtl="true"
        android:theme="@style/Theme.Assist">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Being the default assistant: long-press power / home opens AssistSession over the current app. -->
        <service
            android:name=".AssistService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assist_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".AssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Required by the framework's assistant metadata; never used. Speech goes to Google's recognizer (Speech.kt). -->
        <service
            android:name=".StubRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <receiver
            android:name=".ReopenReceiver"
            android:exported="false" />

        <receiver
            android:name=".InstallStatusReceiver"
            android:exported="false" />

        <receiver
            android:name=".BenchReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- adb only: replay a recorded turn through the live words (see ReplayReceiver). -->
        <receiver
            android:name=".ReplayReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- adb only: copy settings onto the phone (see ConfigReceiver). -->
        <receiver
            android:name=".ConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- The phone's unlock screen to confirm a door unlock or disarm asked while locked (UnlockActivity.kt). -->
        <activity
            android:name=".UnlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The photo button in the text bar: the photo picker or the camera (PhotoActivity.kt). -->
        <activity
            android:name=".PhotoActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Hands the camera app a file to write the new picture into. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>

        <!-- "Share to Assist": text and links, or photos, from any app ride along with the next question. -->
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Ask Assist"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
